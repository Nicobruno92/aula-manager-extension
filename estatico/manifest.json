{
  "manifest_version": 3,
  "name": "Aula Manager: pasar notas",
  "version": "0.2.0",
  "description": "Completa la carga de notas de SIU-Guaraní y de las actas del CBC con las notas de Aula Manager. Vos revisás y guardás.",
  "homepage_url": "https://aula-manager.com",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "iconos/icono-16.png",
    "32": "iconos/icono-32.png",
    "48": "iconos/icono-48.png",
    "128": "iconos/icono-128.png"
  },
  "permissions": [
    "activeTab",
    "alarms",
    "scripting",
    "storage"
  ],
  "background": {
    "service_worker": "fondo.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Pasar notas de Aula Manager",
    "default_icon": {
      "16": "iconos/icono-16.png",
      "32": "iconos/icono-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://aula-manager.com/*"
      ],
      "js": [
        "puente.js"
      ],
      "run_at": "document_start"
    }
  ]
}
